Other approach using String_Agg:

with cte_product_list as (
select customer_id, STRING_AGG(product_name,',') WITHIN GROUP(ORDER BY customer_id) as product_list from Orders
group by customer_id
)
select customer_id,customer_name from Customers
where customer_id in
(select customer_id from cte_product_list WHERE product_list like '%A%' and product_list like '%B%' and product_list not like '%C%')

